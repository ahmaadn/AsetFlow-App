{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "NUXT_PUBLIC_API_BASE",
        "DATABASE_URL",
        "NODE_ENV",
        "CLOUDINARY_API_SECRET",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_CLOUD_NAME",
        "JWT_SECRET",
        "JWT_EXPIRES_IN"
      ]
    },
    "start": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NUXT_PUBLIC_API_BASE",
        "DATABASE_URL",
        "NODE_ENV",
        "CLOUDINARY_API_SECRET",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_CLOUD_NAME",
        "JWT_SECRET",
        "JWT_EXPIRES_IN"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "inputs": [".env"],
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "db:migrate:deploy": {
      "inputs": [".env"],
      "env": ["DATABASE_URL"],
      "cache": false
    }
  },
  "ui": "tui"
}
