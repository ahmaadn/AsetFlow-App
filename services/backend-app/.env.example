# Environment Configuration
# Copy this file to .env and fill in your actual values

# Application Environment (development, production, test)
NODE_ENV=development

# Server Configuration
PORT=8000
CORS_ORIGIN=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/asetflow

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_ROOT_FOLDER=asetflow

# JWT Configuration (RS256 keys)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ISSUER=asetflow-backend
JWT_AUDIENCE=asetflow-app

# Email Service Configuration, available options: 'google', 'smtp'
MAIL_SERVICE_PROVIDER=google

# Google email service configuration
GOOGLE_APP_MAIL=your-google-app-email@gmail.com
GOOGLE_APP_PASSWORD=your-google-app-password

# SMTP email service configuration (alternative to Google)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME=AsetFlow
SMTP_FROM_ADDRESS=noreply@asetflow.com

# Logging Configuration
LOG_LEVEL=info

