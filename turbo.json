{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.json"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"],
      "env": [
        "NUXT_PUBLIC_*",
        "DATABASE_URL",
        "NODE_ENV",
        "CORS_ORIGIN",
        "CLOUDINARY_*",
        "BETTER_AUTH_*",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "MAIL_SERVICE_PROVIDER",
        "GOOGLE_APP_MAIL",
        "GOOGLE_APP_PASSWORD",
        "SMTP_*",
        "JWT_*"
      ]
    },
    "start": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NUXT_PUBLIC_*",
        "DATABASE_URL",
        "NODE_ENV",
        "CORS_ORIGIN",
        "CLOUDINARY_*",
        "BETTER_AUTH_*",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "MAIL_SERVICE_PROVIDER",
        "GOOGLE_APP_MAIL",
        "GOOGLE_APP_PASSWORD",
        "SMTP_*",
        "JWT_*"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "inputs": [".env"],
      "env": ["DATABASE_URL"],
      "cache": false
    },
    "db:deploy": {
      "inputs": [".env"],
      "env": ["DATABASE_URL"],
      "cache": false
    }
  },
  "ui": "tui"
}
